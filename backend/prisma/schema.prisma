// Prisma schema for Ideator

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?  // Optional for OAuth users
  name      String
  profileData Json?  @map("profile_data") // { expertise, funding, followers, linkedInUrl, etc. }
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ideas     Idea[]
  oauthAccounts OAuthAccount[]

  @@map("users")
}

model OAuthAccount {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  provider     String   // google, facebook, etc.
  providerId   String   @map("provider_id") // User ID from OAuth provider
  accessToken  String?  @map("access_token") @db.Text
  refreshToken String?  @map("refresh_token") @db.Text
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Idea {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  title          String
  description    String    @db.Text
  status         String    @default("pending") // pending, analyzing, completed, failed
  pdfPath        String?   @map("pdf_path") // File path for cached PDF
  pdfGeneratedAt DateTime? @map("pdf_generated_at") // When PDF was generated
  pdfVersion     Int       @default(1) @map("pdf_version") // Version for cache invalidation
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses    Analysis[]
  tasks       Task[]

  @@unique([userId, title])
  @@index([userId])
  @@map("ideas")
}

model Analysis {
  id          String   @id @default(uuid())
  ideaId      String   @map("idea_id")
  sectionType String   @map("section_type") // education, swot, features, business_values, pmf, next_steps, viability, google_keywords
  content     Json     // Flexible JSON structure for each section type
  createdAt   DateTime @default(now()) @map("created_at")

  idea        Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([sectionType])
  @@map("analyses")
}

model Task {
  id          String   @id @default(uuid())
  ideaId      String   @map("idea_id")
  title       String
  description String?  @db.Text
  completed   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  idea        Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@map("tasks")
}
